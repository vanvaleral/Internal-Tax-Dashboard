NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local-only read access for the unauthenticated prototype. Set false before deployment.
DEMO_DATABASE_READ=false
# Generate this pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Independent optional office features; set false and redeploy to disable.
VIRTUAL_OFFICE_GAME_ENABLED=true
VIRTUAL_OFFICE_VOICE_ENABLED=true
# Optional JSON RTCIceServer array, including a TURN relay for restrictive networks.
OFFICE_VOICE_ICE_SERVERS=
